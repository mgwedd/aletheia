<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	PRODUCTION (Release) entitlements — least privilege. Deliberately has no
	calendars/Reminders entitlement: EventKit scheduling is a `.dev`-tier feature
	(EventKitSchedulingFeatureModule), so shipped builds never request it. The dev
	tier uses AletheiaDev.entitlements, which is this file plus that one key.
	Keep the two in sync; scripts/check-entitlements.sh enforces it in CI.
	-->
	<!--
	App Sandbox is on. Aletheia never launches an external process
	(no ffmpeg / whisper-cli / llama subprocess): transcription runs
	in-process via whisper.cpp and the AI model runs in-process via llama.cpp
	(both linked frameworks), so full sandboxing is possible without giving up
	any feature.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Microphone capture (AVAudioEngine tap on the input node). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!--
	Deliberately NO com.apple.security.network.client: the app cannot open a
	network connection. The update check and opt-in model downloads run in the
	bundled XPC helper (Sources/NetworkHelper), the only process with network
	access. scripts/check-entitlements.sh fails CI if the key returns here.
	-->

	<!--
	The user picks the data folder via NSOpenPanel on first launch (it
	opens in iCloud Drive when available; any folder can be chosen). This
	entitlement lets
	a sandboxed app keep read/write access to that folder, via a
	security-scoped bookmark, across future launches.
	-->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
